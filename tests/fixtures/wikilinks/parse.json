        "folders": [],
        "name": "Заметка",
        "heading": null,
        "alias": "псевдоним",
        "from_root": false
      }
    },
    {
      "input": "Заметка|текст#не заголовок",
      "note": "# в псевдониме — часть псевдонима",
      "expected": {
        "folders": [],
        "name": "Заметка",
        "heading": null,
        "alias": "текст#не заголовок",
        "from_root": false
      }
    },
    {
      "input": "Язык C#",
      "note": "# в имени начинает заголовок (на такую заметку ссылки нет)",
      "expected": {
        "folders": [],
        "name": "Язык C",
        "heading": null,
        "alias": null,
        "from_root": false
      }
    },
    {
      "input": "Ёлка",
      "note": "ё сохраняется",
      "expected": {
        "folders": [],
        "name": "Ёлка",
        "heading": null,
        "alias": null,
        "from_root": false
      }
    },
    {
      "input": "Мой план",
      "note": "разложенная форма Unicode не меняется при разборе (ключ — при разрешении)",
      "expected": {
        "folders": [],
        "name": "Мой план",
        "heading": null,
        "alias": null,
        "from_root": false
      }
