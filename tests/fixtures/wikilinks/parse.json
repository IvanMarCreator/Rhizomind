        "heading": null,
        "alias": null,
        "from_root": false
      }
    },
    {
      "input": "Заметка|",
      "note": "пустой псевдоним — нет псевдонима",
      "expected": {
        "folders": [],
        "name": "Заметка",
        "heading": null,
        "alias": null,
        "from_root": false
      }
    },
    {
      "input": "Заметка#Глава#Раздел",
      "note": "заголовок — всё после первого #",
      "expected": {
        "folders": [],
        "name": "Заметка",
        "heading": "Глава#Раздел",
