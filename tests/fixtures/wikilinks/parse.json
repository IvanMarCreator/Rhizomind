        "heading": null,
        "alias": null,
        "from_root": false
      }
    },
    {
      "input": "😀 Эмодзи/Заметка 2",
      "note": "эмодзи и цифры",
      "expected": {
        "folders": [
          "😀 Эмодзи"
        ],
        "name": "Заметка 2",
        "heading": null,
        "alias": null,
        "from_root": false
      }
    },
    {
      "input": "CON",
      "note": "зарезервированное имя разбирается, но не разрешается: такой заметки быть не может",
      "expected": {
        "folders": [],
        "name": "CON",
        "heading": null,
        "alias": null,
        "from_root": false
