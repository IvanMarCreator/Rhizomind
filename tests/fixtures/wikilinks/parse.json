      }
    },
    {
      "input": "Заметка|а|б",
      "note": "псевдоним — всё после первой |",
      "expected": {
        "folders": [],
        "name": "Заметка",
        "heading": null,
        "alias": "а|б",
        "from_root": false
      }
    },
    {
      "input": "Заметка\\|псевдоним",
      "note": "\\| в таблице Markdown — разделитель псевдонима",
