      }
    },
    {
      "input": "Альфа/",
      "note": "нет имени после папки",
      "expected": {
        "invalid": "empty_component"
      }
    },
    {
      "input": "//Встреча",
      "note": "две косые в начале",
      "expected": {
        "invalid": "empty_component"
      }
    },
    {
