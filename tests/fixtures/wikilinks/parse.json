      }
    },
    {
      "input": "/",
      "note": "только косая черта",
      "expected": {
        "invalid": "empty_target"
      }
    },
    {
      "input": "/#Заголовок",
      "note": "корень с заголовком",
      "expected": {
        "invalid": "empty_target"
      }
    },
    {
      "input": "Альфа//Встреча",
      "note": "пустая папка в пути",
      "expected": {
