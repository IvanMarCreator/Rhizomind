{
  "name": "rhizomind",
  "productName": "Rhizomind",
  "version": "0.1.0",
  "description": "Local-only knowledge base with linked Markdown notes. No sync, no cloud, no telemetry.",
  "license": "GPL-3.0-only",
  "author": "Rhizomind contributors",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:network": "node scripts/check-no-network.mjs",
    "build:main": "esbuild src/main/main.ts src/preload/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outbase=src --outdir=dist",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run check:network && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
