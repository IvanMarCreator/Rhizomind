{
  "name": "rhizomind",
  "productName": "Rhizomind",
  "version": "0.1.0",
  "description": "Local-only knowledge base with linked Markdown notes. No sync, no cloud, no telemetry.",
  "license": "GPL-3.0-only",
  "author": "Rhizomind contributors",
  "homepage": "https://github.com/IvanMarCreator/Rhizomind",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:network": "node scripts/check-no-network.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:network && npm run check:licenses",
    "package:portable": "npm run build && electron-builder --publish never",
    "package:installer": "npm run build && electron-builder --win nsis --publish never",
    "sbom": "node -e \"require('node:fs').mkdirSync('release',{recursive:true})\" && npm sbom --sbom-format cyclonedx > release/sbom.json"
  },
  "dependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
