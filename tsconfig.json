{
  // Проверки, сценарные тесты, конфигурации и модульные тесты интерфейса —
  // в Node, с типами Node. Код интерфейса без тестов — src/tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["tools", "tests", "src-isolation", "*.config.ts", "*.config.js", "src/**/*.test.ts", "src/env.d.ts"]
}
